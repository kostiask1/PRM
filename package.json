{
  "name": "dnd-session-manager",
  "version": "1.0.0",
  "description": "Local DnD campaign and session manager",
  "main": "server.js",
  "scripts": {
    "ensure:env": "node scripts/ensure-env.mjs",
    "project": "node scripts/run-project.mjs",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "server": "npm run ensure:env && node --watch --watch-path=server --watch-path=.env server/server.js",
    "client": "vite",
    "start:prod": "node server/server.js",
    "test": "node --experimental-specifier-resolution=node tests/run-tests.mjs",
    "lint": "eslint . && npm run check:uk",
    "check:uk": "node scripts/check-ukrainian-encoding.mjs",
    "bestiary:materialize-copies": "node scripts/materialize-bestiary-copies.mjs",
    "database:bundle": "node scripts/build-database-bundles.mjs",
    "database:bundle:compact": "node scripts/build-database-bundles.mjs --delete-sources",
    "database:update": "node scripts/update-5etools-data.mjs"
  },
  "keywords": [
    "dnd",
    "campaign",
    "session",
    "manager",
    "node",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.17.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-list": "^0.8.17",
    "react-markdown": "^9.0.1",
    "react-router": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fallow": "^2.88.2",
    "globals": "^15.14.0",
    "sass": "^1.77.0",
    "sass-embedded": "^1.98.0",
    "vite": "^5.4.2"
  }
}
