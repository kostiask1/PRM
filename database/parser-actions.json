{
	"version": 1,
	"source": "database/bestiary/all.json",
	"actions": [
		{
			"type": "damage",
			"interaction": "form",
			"label": "Roll damage",
			"group": "Rolls and damage",
			"template": "({@damage {{formula}}{{||label}}})",
			"description": "Insert a clickable damage roll. An optional label changes the displayed text without changing the formula.",
			"example": "({@damage 2d6 + 2})",
			"fields": [
				{
					"name": "formula",
					"label": "Dice formula",
					"control": "text",
					"required": true,
					"defaultValue": "2d6 + 2",
					"placeholder": "2d6 + 2",
					"useSelection": true,
					"pattern": "^\\s*\\d+d\\d+(?:\\s*[+-]\\s*(?:\\d+d\\d+|\\d+))*\\s*$",
					"validationMessage": "Use a fixed damage formula such as 2d6 + 2."
				},
				{
					"name": "label",
					"label": "Displayed label",
					"control": "text",
					"required": false,
					"defaultValue": "",
					"placeholder": "9 damage",
					"useSelection": false
				}
			]
		},
		{
			"type": "dice",
			"interaction": "form",
			"label": "Roll dice",
			"group": "Rolls and damage",
			"template": "{@dice {{formula}}{{|label}}}",
			"description": "Insert a clickable general-purpose dice roll with an optional displayed label.",
			"example": "{@dice 1d20 + 5|attack roll}",
			"fields": [
				{
					"name": "formula",
					"label": "Dice formula",
					"control": "text",
					"required": true,
					"defaultValue": "1d20 + 5",
					"placeholder": "1d20 + 5",
					"useSelection": true
				},
				{
					"name": "label",
					"label": "Displayed label",
					"control": "text",
					"required": false,
					"defaultValue": "",
					"placeholder": "attack roll",
					"useSelection": false
				}
			]
		},
		{
			"type": "hit-damage-line",
			"interaction": "form",
			"label": "Add hit and damage line",
			"group": "Rolls and damage",
			"template": "{@h}{{average}} ({@damage {{formula}}}) {{damageType}} damage",
			"description": "Build the common Hit: average (dice) damage line used throughout the Bestiary.",
			"example": "{@h}9 ({@damage 2d6 + 2}) bludgeoning damage",
			"fields": [
				{
					"name": "average",
					"label": "Average damage",
					"control": "number",
					"required": true,
					"defaultValue": "9",
					"placeholder": "9",
					"useSelection": false,
					"min": 0
				},
				{
					"name": "formula",
					"label": "Dice formula",
					"control": "text",
					"required": true,
					"defaultValue": "2d6 + 2",
					"placeholder": "2d6 + 2",
					"useSelection": true,
					"pattern": "^\\s*\\d+d\\d+(?:\\s*[+-]\\s*(?:\\d+d\\d+|\\d+))*\\s*$",
					"validationMessage": "Use a fixed damage formula such as 2d6 + 2."
				},
				{
					"name": "damageType",
					"label": "Damage type",
					"control": "text",
					"required": true,
					"defaultValue": "bludgeoning",
					"placeholder": "bludgeoning",
					"useSelection": false
				}
			]
		},
		{
			"type": "hit",
			"interaction": "form",
			"label": "Add attack bonus",
			"group": "Rolls and damage",
			"template": "{@hit {{bonus}}}",
			"description": "Insert a clickable d20 attack roll using the specified attack bonus.",
			"example": "{@hit +7}",
			"fields": [
				{
					"name": "bonus",
					"label": "Attack bonus",
